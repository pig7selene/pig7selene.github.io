---
import { cn } from '@/utils'
import { type TocItem } from '@/plugins/toc'

interface Props {
  heading: TocItem
}

const {
  heading: { depth, slug, subheadings, text }
} = Astro.props
---

<li data-toc-item data-slug={slug} data-depth={depth}>
  <div class='relative'>
    <span
      class='absolute top-[5%] w-[2px] rounded transition-colors duration-300 [&.highlight-bg]:bg-primary [&.readed]:bg-input'
    ></span>
    <a
      aria-label={`Scroll to section: ${text}`}
      class={cn(
        'line-clamp-2 px-3 py-1 ms-2 flex-1 text-foreground/75 transition-all hover:text-foreground [&.highlight]:font-medium [&.highlight]:text-primary [&.readed]:text-input [&.highlight-bg-translucent]:bg-muted',
        depth === 3 && 'ps-7',
        depth === 4 && 'ps-10',
        depth === 5 && 'ps-14'
      )}
      aria-expanded={subheadings.length ? 'false' : undefined}
      href={`#${slug}`}>{text}</a
    >
  </div>
  {
    !!subheadings.length && (
      <div
        class='toc-children'
        data-toc-children
        data-parent-slug={slug}
        data-expanded='false'
        aria-hidden='true'
      >
        <div class='toc-children-inner'>
          <ul>
            {subheadings.map((subheading) => (
              <Astro.self heading={subheading} />
            ))}
          </ul>
        </div>
      </div>
    )
  }
</li>

<style>
  .toc-children {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    visibility: hidden;
    transition:
      grid-template-rows 240ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease-out,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 240ms;
  }

  .toc-children-inner {
    min-height: 0;
    overflow: hidden;
  }

  .toc-children[data-expanded='true'] {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-children {
      transform: none;
      transition: none;
    }
  }
</style>

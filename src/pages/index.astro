---
import { Image } from 'astro:assets'
import { getBlogCollection, sortMDByDate } from '@/server'

import PageLayout from '@/layouts/BaseLayout.astro'
import BlogStats from '@/components/home/BlogStats.astro'
import GitHubActivityCalendar from '@/components/home/GitHubActivityCalendar.astro'
import Section from '@/components/home/Section.astro'
import { PostPreview } from '@/components/pages'
import { Button, Icon, Label } from '@/components/user'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const recentPosts = sortMDByDate(await getBlogCollection()).slice(0, 5)
---

<PageLayout
  meta={{ title: 'Home', description: config.description }}
  highlightColor='#789ac466'
  homeHero
>
  <main
    class='relative z-10 -mt-6 flex w-full flex-col items-center rounded-t-2xl border border-b-0 border-border/60 bg-background/95 px-4 pt-8 shadow-2xl shadow-black/10 backdrop-blur-sm dark:shadow-black/30 sm:px-7 md:-mt-16 md:rounded-t-[2rem] md:px-10 md:pt-10'
  >
    <section
      class='animate mb-10 flex w-full flex-col items-start gap-y-7 md:w-5/6'
      id='content-header'
    >
      <div class='flex flex-row items-center gap-x-6'>
        <Image
          src={avatar}
          alt={`${config.author}'s avatar`}
          class='size-32 rounded-2xl border object-cover p-1 sm:size-36'
          loading='eager'
        />
        <div class='flex flex-col gap-y-4'>
          <div>
            <h1 class='text-3xl font-bold'>{config.author}</h1>
          </div>
          <div class='flex flex-wrap gap-1'>
            {
              config.personal?.location && (
                <Label title={config.personal.location}>
                  <Icon name='location' class='size-4' slot='icon' />
                </Label>
              )
            }
            {
              config.personal?.githubUsername && (
                <Label
                  title='GitHub'
                  as='a'
                  href={`https://github.com/${config.personal.githubUsername}`}
                  target='_blank'
                >
                  <Icon name='github' class='size-4' slot='icon' />
                </Label>
              )
            }
            {
              config.personal?.email && (
                <Label title='Email' as='a' href={`mailto:${config.personal.email}`}>
                  <Icon name='email' class='size-4' slot='icon' />
                </Label>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex w-full flex-col gap-y-12 md:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>
          I am interested in machine learning, natural language processing, large language models,
          theoretical computer science, and mathematics. This site is my personal archive of notes,
          experiments, projects, and thoughts.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>

      <Section title='Latest Notes'>
        <ul class='flex flex-col gap-y-4'>
          {recentPosts.map((post) => <PostPreview {post} detailed />)}
        </ul>
        <Button
          title='Browse all posts'
          class='w-fit self-end'
          href='/blog/learning'
          style='ahead'
        />
      </Section>

      {
        config.personal?.githubUsername && (
          <Section title='Contributions'>
            <GitHubActivityCalendar username={config.personal.githubUsername} />
          </Section>
        )
      }

      <Section title='Statistics'>
        <BlogStats
          blogStartDate={config.personal?.blogStartDate
            ? new Date(config.personal.blogStartDate)
            : new Date('2026-06-25')}
        />
      </Section>
    </div>
  </main>
</PageLayout>
